{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.getrelvo.ai" }],
      "destination": "https://getrelvo.ai/:path*",
      "statusCode": 301
    },
    { "source": "/about-us", "destination": "/", "statusCode": 301 },
    { "source": "/soluciones", "destination": "/", "statusCode": 301 },
    { "source": "/soluciones/head-of-revenue", "destination": "/soluciones/revenue-ops", "statusCode": 301 },
    { "source": "/soluciones/finanzas-revops", "destination": "/soluciones/finanzas", "statusCode": 301 },
    { "source": "/pricing", "destination": "/precios", "statusCode": 301 },
    { "source": "/en/precios", "destination": "/en/pricing", "statusCode": 301 },
    { "source": "/en/powered-by-relvo", "destination": "/powered-by-relvo", "statusCode": 301 },
    { "source": "/docs", "destination": "https://app.getrelvo.ai/docs/product/es/overview/", "statusCode": 301 },
    { "source": "/docs/:path*", "destination": "https://app.getrelvo.ai/docs/product/es/overview/", "statusCode": 301 },
    { "source": "/shader-only", "destination": "/", "statusCode": 301 },
    { "source": "/linkedin-banner", "destination": "/", "statusCode": 301 },
    { "source": "/terminos", "destination": "https://app.relvoerp.com/terms", "statusCode": 301 },
    { "source": "/en/terms", "destination": "https://app.relvoerp.com/terms", "statusCode": 301 },
    { "source": "/privacidad", "destination": "https://app.relvoerp.com/privacy", "statusCode": 301 },
    { "source": "/en/privacy", "destination": "https://app.relvoerp.com/privacy", "statusCode": 301 },
    { "source": "/login", "destination": "https://app.getrelvo.ai/login", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "https://relvo-blog.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://relvo-blog.vercel.app/blog/:path*" }
  ],
  "headers": [
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
