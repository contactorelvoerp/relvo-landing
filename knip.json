{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/entry-server.jsx",
    "scripts/*.mjs",
    "api/*.js",
    "tests/*.test.mjs"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "scripts/**/*.mjs",
    "api/**/*.js",
    "content/**/*.mjs",
    "shared/**/*.js",
    "tests/*.test.mjs",
    "server/**/*.js"
  ],
  "ignoreDependencies": [
    "impeccable"
  ]
}
