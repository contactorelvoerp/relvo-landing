{
  "name": "relvo-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio público de Relvo (getrelvo.ai)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/og.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,mjs --report-unused-disable-directives --max-warnings 0",
    "knip": "knip",
    "check:links": "node scripts/check-links.mjs",
    "check:bands": "node scripts/check-bands.mjs",
    "check:design": "node scripts/impeccable-gate.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:prod-seo": "node scripts/check-prod-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "analytics:plan": "node scripts/configure-analytics.mjs",
    "analytics:apply": "node scripts/configure-analytics.mjs --apply",
    "test:schema": "node scripts/check-distribution-schema.mjs",
    "test:browser": "playwright test",
    "check:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "test:flows": "node scripts/check-lead-flows.mjs",
    "check:prod-flows": "node scripts/check-prod-flows.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@vercel/functions": "^3.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "impeccable": "latest",
    "knip": "^5.0.0",
    "vite": "^5.0.8",
    "zod": "^4.6.5"
  }
}
